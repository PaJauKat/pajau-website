---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'CA Tier Calculator',
    subtitle: 'KatServices',
    description: 'Herramienta web sencilla para analizar y calcular progresos de Combat Achievements en OSRS.',
    tag: 'OSRS',
    badge: 'Web',
    tech: ['Astro', 'TypeScript'],
    link: '/ca-tier-calculator',
    isExternal: false,
    featured: true,
    public: true
  },
  {
    title: 'KatPlugins',
    subtitle: 'RuneLite Plugins',
    description: 'Plugins y pequeños módulos en Java para personalizar la interfaz y utilidades en RuneLite.',
    tag: 'OSRS',
    badge: 'Plugin',
    tech: ['Java', 'RuneLite API'],
    link: '/plugins',
    isExternal: false,
    featured: true,
    public: false
  },
  {
    title: 'Timers CA',
    subtitle: 'RuneLite Plugin',
    description: 'Muestra el tiempo en tiempo real para jefes específicos de Combat Achievements en OSRS.',
    tag: 'OSRS',
    badge: 'Plugin',
    tech: ['Java', 'RuneLite API'],
    link: 'https://github.com/PaJauKat/Timers-CA',
    isExternal: true,
    featured: false,
    public: true
  },
  {
    title: 'KatAccountManager',
    subtitle: 'Jagex Accounts Manager',
    description: 'Herramienta con interfaz gráfica para gestionar e iniciar sesión rápidamente con múltiples cuentas de Jagex.',
    tag: 'OSRS',
    badge: 'Escritorio',
    tech: ['Java', 'Swing'],
    link: 'https://github.com/PaJauKat/KatAccountManager',
    isExternal: true,
    featured: false,
    public: true
  },
  {
    title: 'KatHub',
    subtitle: 'Launcher / Instalador',
    description: 'Aplicación de escritorio para instalar y gestionar fácilmente el resto de mis herramientas.',
    tag: 'Utilidad',
    badge: 'Escritorio',
    tech: ['C#', 'WPF'],
    link: 'https://github.com/PaJauKat/KatHub',
    isExternal: true,
    featured: false,
    public: false
  },
  {
    title: 'KatImgDetector',
    subtitle: 'Detector de Imágenes',
    description: 'Herramienta de escritorio para comparar y probar distintos modelos de detección de objetos en tiempo real.',
    tag: 'Visión por Computador',
    badge: 'Escritorio',
    tech: ['C#', 'WPF', 'OpenCV', 'YOLO'],
    link: 'https://github.com/PaJauKat/KatImageDetector',
    isExternal: true,
    featured: false,
    public: true
  },
  {
    title: 'KatImgDetectorWeb',
    subtitle: 'Detector de Imágenes Web',
    description: 'Versión web para evaluar y comparar detectores de imágenes directamente en el navegador.',
    tag: 'Visión por Computador',
    badge: 'Web',
    tech: ['TypeScript', 'React', 'OpenCV', 'YOLO'],
    link: 'https://github.com/PaJauKat/kat-detector',
    isExternal: true,
    featured: false,
    public: true
  }
];

const projects2 = [
  {
    title: 'Calculadora CA',
    subtitle: 'Combat Achievements Tool',
    description: 'Herramienta web sencilla para analizar y calcular progresos de Combat Achievements en OSRS.',
    tag: 'Herramienta OSRS',
    tech: ['Astro', 'TypeScript'],
    link: '/ca-tier-calculator',
    isExternal: false,
    featured: true,
    badge: 'Herramienta'
  },
  {
    title: 'Plugins de RuneLite',
    subtitle: 'RuneLite / OSRS Mods',
    description: 'Plugins y pequeños módulos en Java para personalizar la interfaz y utilidades en RuneLite.',
    tag: 'RuneLite',
    tech: ['Java', 'RuneLite API'],
    link: '/plugins',
    isExternal: false,
    featured: true,
    badge: 'Hobby'
  },
  {
    title: 'GitHub Repositories',
    subtitle: '@PaJauKat',
    description: 'Mi perfil de GitHub donde subo mis proyectos, experimentos y el código que voy escribiendo.',
    tag: 'Código Fuente',
    tech: ['Git', 'Open Source'],
    link: 'https://github.com/PaJauKat',
    isExternal: true,
    featured: false,
    badge: 'GitHub'
  },
  {
    title: 'Próximos Proyectos',
    subtitle: 'En construcción...',
    description: 'Espacio reservado para cualquier otra idea, script o bot que se me ocurra programar más adelante.',
    tag: 'Ideas',
    tech: ['APIs', 'Scripts'],
    link: 'https://github.com/PaJauKat',
    isExternal: true,
    featured: false,
    badge: 'Futuro'
  }
];

const skillCategories = [
  {
    category: 'Lenguajes Principales',
    type: 'icons',
      items: [
      { name: 'Java', icon: '/icons/java2.svg' },
      { name: 'Python', icon: '/icons/python2.svg' },
      { name: 'TypeScript', icon: '/icons/typescript.svg' },
      { name: 'JavaScript', icon: '/icons/javascript.svg' },
      { name: 'C', icon: '/icons/c2.svg' },
      { name: 'C#', icon: '/icons/csharp.svg'},
      { name: 'Go', icon: '/icons/go.svg' }
    ]
  },
  {
    category: 'Frameworks & Librerías',
    type: 'badges',
    items: ['FastAPI', 'Astro', 'Avalonia', 'WPF', 'Guice']
  },
  {
    category: 'Herramientas & Base de Datos',
    type: 'badges',
    items: ['Git', 'Supabase', 'SQL', "MongoDB", 'RabbitMQ']
  }
];
---

<Layout title="Pajau | Proyectos & Software por Hobby" description="Sitio personal de Pajau (@PaJauKat): proyectos de software por hobby, herramientas y rincón fan de Katarina.">
  <div class="page-container">
    
    <!-- Top Navigation -->
    <header class="navbar">
      <a href="#top" class="brand">
        <img src="/logo.png" alt="Pajau Logo" class="brand-img" />
        <div class="brand-text">
          <span class="brand-name">PAJAU<span class="dot">.</span></span>
          <span class="brand-sub">HOBBY DEV</span>
        </div>
      </a>

      <nav class="nav-links">
        <a href="#proyectos">Proyectos</a>
        <a href="/katarina">Katarina Corner</a>
        <a href="#sobre-mi">Sobre mí</a>
      </nav>

      <div class="nav-actions">
        <a href="https://github.com/PaJauKat" target="_blank" rel="noopener noreferrer" class="btn btn-github">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <!-- Hero Section -->
    <section id="top" class="hero">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span>Programando por Hobby & Diversión</span>
        </div>

        <h1 class="hero-title">
          Haciendo código por hobby, <br />
          <span class="highlight">sin pretensiones.</span>
        </h1>

        <p class="hero-description">
          Soy <strong class="text-white">Pajau</strong> (@PaJauKat). No soy un experto en diseño ni desarrollador; solo un aficionado que programa en su tiempo libre, haciendo utilidades, plugins y proyectos sencillos por puro interés personal.
        </p>

        <div class="hero-tags">
          <div class="tag-chip">
            <span class="tag-icon">⚔️</span>
            <span>Katarina Fan</span>
          </div>
          <div class="tag-chip">
            <span class="tag-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </span>
            <span>@PaJauKat</span>
          </div>
          <div class="tag-chip">
            <span class="tag-icon">💻</span>
            <span>Proyectos por Hobby</span>
          </div>
        </div>

        <div class="hero-cta">
          <a href="#proyectos" class="btn btn-primary">
            <span>Ver Proyectos</span>
            <span class="btn-arrow">→</span>
          </a>
          <a href="https://github.com/PaJauKat" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <span>Ver GitHub</span>
            <span class="btn-arrow">↗</span>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="katarina-card-featured">
          <div class="card-glow"></div>
          <div class="card-inner">
            <img id="hero-featured-img" src="/katarina2.jpg" alt="Katarina Du Couteau" class="hero-img" />
            <div class="hero-img-gradient"></div>
            
            <div class="card-caption">
              <div class="caption-header">
                <span id="hero-featured-tag" class="caption-tag">Campeona Favorita (LoL)</span>
                <span class="caption-blade">🗡️</span>
              </div>
              <h3 id="hero-featured-title" class="caption-title">The Sinister Blade</h3>
              <p id="hero-featured-quote" class="caption-quote">"Violence solves everything."</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="proyectos" class="section projects-section">
      <div class="section-header">
        <div class="header-badge">PROYECTOS & HERRAMIENTAS</div>
        <h2 class="section-title">Cosas que he programado <span class="highlight-red">⚡</span></h2>
        <p class="section-sub">Herramientas simples, experimentos de código y utilidades para juegos.</p>
      </div>

      <div class="projects-grid">
        {projects.map((proj) => (
          <article class={`project-card ${proj.featured ? 'featured' : ''}`}>
            <div class="card-top">
              <span class="card-tag">{proj.tag}</span>
              <span class="card-badge">{proj.badge}</span>
            </div>

            <div class="card-body">
              <h3 class="proj-title">{proj.title}</h3>
              <p class="proj-sub">{proj.subtitle}</p>
              <p class="proj-desc">{proj.description}</p>
            </div>

            <div class="card-bottom">
              <div class="tech-stack">
                {proj.tech.map((t) => (
                  <span class="tech-pill">{t}</span>
                ))}
              </div>

              <a 
                href={proj.link} 
                target={proj.isExternal ? "_blank" : "_self"} 
                rel={proj.isExternal ? "noopener noreferrer" : ""} 
                class="proj-link"
              >
                <span>Acceder</span>
                <span class="link-icon">{proj.isExternal ? '↗' : '→'}</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Katarina Corner Teaser Section -->
    <section id="katarina" class="section katarina-teaser-section">
      <div class="katarina-banner-card">
        <div class="banner-info">
          <div class="header-badge">WAIFU CORNER 🗡️</div>
          <h2 class="section-title">Katarina Du Couteau</h2>
          <p class="banner-desc">
            Mi campeona favorita de League of Legends y referente de la temática del sitio.
          </p>
          <p class="banner-disclaimer">
            <em>* Aclaración: Las imágenes no son de mi autoría, son solo ilustraciones y renders que me gustan.</em>
          </p>
          <a href="/katarina" class="btn btn-primary btn-lg mt-4">
            <span>Ver Rincón de Katarina</span>
            <span>→</span>
          </a>
        </div>
        <div class="banner-image-preview">
          <img src="/katarina1.jpg" alt="Katarina Artwork" class="preview-thumb" />
        </div>
      </div>
    </section>

    <!-- About Me & Skills Section -->
    <section id="sobre-mi" class="section about-section">
      <div class="about-grid">
        <div class="about-card main-bio">
          <div class="header-badge">SOBRE MÍ</div>
          <h2>Programación por puro hobby</h2>
          <p>Me enfoco en el desarrollo de herramientas, automatización de tareas y creación de plugins personalizados. Cuento con una sólida base en matemática, física y lógica de sistemas tras 5 años en Ingeniería Civil Electrónica, aplicando ese enfoque analítico para entender cómo funcionan las cosas por dentro y resolver problemas mediante código.</p>
          
          <div class="bio-stats">
            <div class="stat-item">
              <span class="stat-number">PaJau</span>
              <span class="stat-label">Alias</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">GitHub</span>
              <span class="stat-label">@PaJauKat</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">Hobby</span>
              <span class="stat-label">Software & Games</span>
            </div>
          </div>
        </div>

        <div class="about-card skills-panel">
          <div class="header-badge">LO QUE UTILIZO</div>
          
          <div class="skills-grid">
            {skillCategories.map((cat) => (
              <div class="skill-category">
                <div class="category-header">
                  <h4>{cat.category}</h4>
                </div>

                {cat.type === 'icons' ? (
                  <div class="skill-badges">
                    {(cat.items as { name: string; icon: string }[]).map((it) => (
                      <span class="skill-badge icon-badge">
                        <img src={it.icon} alt={it.name} class="skill-img-small" />
                        <span>{it.name}</span>
                      </span>
                    ))}
                  </div>
                ) : (
                  <div class="skill-badges">
                    {cat.items.map((b) => (
                      <span class="skill-badge">{b}</span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Discord banner removed -->
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src="/logo.png" alt="Pajau Logo" class="footer-logo" />
          <span class="footer-title">PAJAU</span>
        </div>

        <p class="footer-quote">
          "Violence solves everything... o al menos eso dice Katarina." 🗡️
        </p>

        <div class="footer-links">
          <a href="https://github.com/PaJauKat" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="/ca-tier-calculator">Calculadora CA</a>
          <a href="/plugins">Plugins</a>
          <a href="/katarina">Katarina Corner</a>
        </div>

        <div class="footer-copy">
          © {new Date().getFullYear()} Pajau.
        </div>
      </div>
    </footer>

  </div>
</Layout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 24px 60px;
    position: relative;
    z-index: 1;
  }

  /* Navbar */
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: rgba(12, 16, 24, 0.7);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    margin-bottom: 40px;
    position: sticky;
    top: 20px;
    z-index: 100;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-img {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .brand-name .dot {
    color: var(--crimson);
  }

  .brand-sub {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--crimson);
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 28px;
  }

  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--crimson-hover);
  }

  .nav-actions {
    display: flex;
    gap: 10px;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--crimson) 0%, var(--crimson-dark) 100%);
    color: #fff;
    box-shadow: 0 4px 20px var(--crimson-glow);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(255, 42, 85, 0.6);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--border-subtle);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border);
    transform: translateY(-2px);
  }

  .btn-github {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .btn-github:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .btn-discord {
    background: rgba(88, 101, 242, 0.15);
    color: #7289da;
    border-color: rgba(88, 101, 242, 0.3);
  }

  .btn-discord:hover {
    background: rgba(88, 101, 242, 0.25);
    color: #fff;
    border-color: rgba(88, 101, 242, 0.5);
    transform: translateY(-2px);
  }

  .btn-lg {
    padding: 14px 24px;
    font-size: 1rem;
  }

  /* Hero Section */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    padding: 40px 0 80px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(255, 42, 85, 0.08);
    border: 1px solid var(--border);
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--crimson);
    margin-bottom: 20px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: var(--crimson);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--crimson);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
    100% { transform: scale(0.95); opacity: 1; }
  }

  .hero-title {
    font-family: var(--font-title);
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .highlight {
    background: linear-gradient(135deg, #ff2a55 0%, #ff8099 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 28px;
    max-width: 580px;
  }

  .text-white {
    color: var(--text-primary);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }

  .tag-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    font-size: 0.82rem;
    color: var(--text-secondary);
    /* 1. Define aquí tu fuente */
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    
    /* 2. Reduce la altura de línea para evitar que el texto caiga */
    line-height: 1;
  }

  /* 3. Alinea perfectamente el contenedor del icono */
  .tag-icon {
    display: flex;
    align-items: center;
  }

  .tag-icon svg {
    display: block; /* Elimina el margen inferior invisible propio de los SVGs */
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Hero Visual Card */
  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .katarina-card-featured {
    position: relative;
    width: 100%;
    max-width: 420px;
    border-radius: 24px;
    padding: 2px;
    background: linear-gradient(135deg, rgba(255, 42, 85, 0.4) 0%, rgba(255, 255, 255, 0.05) 100%);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .card-glow {
