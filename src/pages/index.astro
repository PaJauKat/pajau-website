---
import Layout from '../layouts/Layout.astro';

const katarinaGallery = [
  {
    id: 'kat2',
    src: '/katarina2.jpg',
    title: 'The Sinister Blade',
    subtitle: 'Katarina Du Couteau',
    quote: '"Violence solves everything."',
    tag: 'Favorite Champion & Waifu'
  },
  {
    id: 'kat1',
    src: '/katarina1.jpg',
    title: 'Red Daggers',
    subtitle: 'Noxian Assassin',
    quote: '"Never question my loyalty. You will never see what I do for Noxus."',
    tag: 'Agility & Lethality'
  },
  {
    id: 'kat3',
    src: '/katarina3.jpg',
    title: 'Death Lotus',
    subtitle: 'Blades in the Dark',
    quote: '"Too slow!"',
    tag: 'Precision & Speed'
  },
  {
    id: 'kat5',
    src: '/katarina5.png',
    title: 'Katarina Render',
    subtitle: 'High Definition Artwork',
    quote: '"Why? Because I can."',
    tag: 'Visual Signature'
  }
];

const projects = [
  {
    title: 'Calculadora CA',
    subtitle: 'Combat Achievements Tool',
    description: 'Herramienta web optimizada para analizar, organizar y calcular progresos de Combat Achievements.',
    tag: 'Herramienta',
    tech: ['Astro', 'TypeScript', 'Gaming UI'],
    link: '/ca-tier-calculator',
    isExternal: false,
    featured: true,
    badge: 'Destacado'
  },
  {
    title: 'Plugins de RuneLite',
    subtitle: 'RuneLite / OSRS Mods',
    description: 'Plugins y módulos orientados a potenciar la interfaz y automatización de métricas en RuneLite.',
    tag: 'Game Tools',
    tech: ['Java', 'RuneLite API', 'Open Source'],
    link: '/plugins',
    isExternal: false,
    featured: true,
    badge: 'Popular'
  },
  {
    title: 'GitHub Repositories',
    subtitle: '@PaJauKat',
    description: 'Perfil oficial con código fuente, herramientas experimentales y proyectos en desarrollo constante.',
    tag: 'Código Fuente',
    tech: ['Git', 'Full Stack', 'Software Dev'],
    link: 'https://github.com/PaJauKat',
    isExternal: true,
    featured: false,
    badge: 'GitHub'
  },
  {
    title: 'Próximos Proyectos',
    subtitle: 'En construcción...',
    description: 'Espacio preparado para integrar nuevas aplicaciones, servicios web, bots y herramientas.',
    tag: 'Futuro',
    tech: ['APIs', 'Automation', 'Nuevas Apps'],
    link: 'https://github.com/PaJauKat',
    isExternal: true,
    featured: false,
    badge: 'Próximamente'
  }
];

const skills = [
  { name: 'TypeScript & JavaScript', level: 'Avanzado', icon: '⚡' },
  { name: 'Astro & Frontend UI', level: 'Avanzado', icon: '🚀' },
  { name: 'Java & Game Tooling', level: 'Intermedio', icon: '☕' },
  { name: 'Diseño Dark & UX', level: 'Especialidad', icon: '🎨' },
  { name: 'Git & GitHub Workflow', level: 'Avanzado', icon: '🐙' },
  { name: 'Automatizaciones & Scripting', level: 'Intermedio', icon: '🛠️' }
];
---

<Layout title="Pajau | Software Developer & Portfolio" description="Portafolio personal de Pajau (@PaJauKat): Desarrollador de software, herramientas web, plugins y estética inspirada en Katarina.">
  <div class="page-container">
    
    <!-- Top Navigation -->
    <header class="navbar">
      <a href="#top" class="brand">
        <img src="/logo.png" alt="Pajau Logo" class="brand-img" />
        <div class="brand-text">
          <span class="brand-name">PAJAU<span class="dot">.</span></span>
          <span class="brand-sub">SOFTWARE DEV</span>
        </div>
      </a>

      <nav class="nav-links">
        <a href="#proyectos">Proyectos</a>
        <a href="#katarina">Katarina Corner</a>
        <a href="#sobre-mi">Sobre mí</a>
      </nav>

      <div class="nav-actions">
        <a href="https://github.com/PaJauKat" target="_blank" rel="noopener noreferrer" class="btn btn-github">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>GitHub</span>
        </a>
        <a href="/rch" target="_blank" rel="noopener noreferrer" class="btn btn-discord">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <span>Discord</span>
        </a>
      </div>
    </header>

    <!-- Hero Section -->
    <section id="top" class="hero">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span>Desarrollador de Software & Creador</span>
        </div>

        <h1 class="hero-title">
          Código con impacto, <br />
          <span class="highlight">estética carmesí.</span>
        </h1>

        <p class="hero-description">
          Soy <strong class="text-white">Pajau</strong>, desarrollador enfocado en construir herramientas útiles, aplicaciones web modernas y plugins de alto rendimiento. Mi lema es crear software preciso y directo al grano.
        </p>

        <div class="hero-tags">
          <div class="tag-chip">
            <span class="tag-icon">⚔️</span>
            <span>Waifu: Katarina</span>
          </div>
          <div class="tag-chip">
            <span class="tag-icon">🐙</span>
            <span>@PaJauKat</span>
          </div>
          <div class="tag-chip">
            <span class="tag-icon">⚡</span>
            <span>Open Source & Tools</span>
          </div>
        </div>

        <div class="hero-cta">
          <a href="#proyectos" class="btn btn-primary">
            <span>Explorar Proyectos</span>
            <span class="btn-arrow">→</span>
          </a>
          <a href="https://github.com/PaJauKat" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <span>Ver GitHub</span>
            <span class="btn-arrow">↗</span>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="katarina-card-featured">
          <div class="card-glow"></div>
          <div class="card-inner">
            <img id="hero-featured-img" src="/katarina2.jpg" alt="Katarina The Sinister Blade" class="hero-img" />
            <div class="hero-img-gradient"></div>
            
            <div class="card-caption">
              <div class="caption-header">
                <span id="hero-featured-tag" class="caption-tag">Favorite Champion & Waifu</span>
                <span class="caption-blade">🗡️</span>
              </div>
              <h3 id="hero-featured-title" class="caption-title">The Sinister Blade</h3>
              <p id="hero-featured-quote" class="caption-quote">"Violence solves everything."</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="proyectos" class="section projects-section">
      <div class="section-header">
        <div class="header-badge">PROYECTOS & HERRAMIENTAS</div>
        <h2 class="section-title">Portafolio en crecimiento <span class="highlight-red">⚡</span></h2>
        <p class="section-sub">Soluciones prácticas, calculadoras de juego y desarrollo de código abierto.</p>
      </div>

      <div class="projects-grid">
        {projects.map((proj) => (
          <article class={`project-card ${proj.featured ? 'featured' : ''}`}>
            <div class="card-top">
              <span class="card-tag">{proj.tag}</span>
              <span class="card-badge">{proj.badge}</span>
            </div>

            <div class="card-body">
              <h3 class="proj-title">{proj.title}</h3>
              <p class="proj-sub">{proj.subtitle}</p>
              <p class="proj-desc">{proj.description}</p>
            </div>

            <div class="card-bottom">
              <div class="tech-stack">
                {proj.tech.map((t) => (
                  <span class="tech-pill">{t}</span>
                ))}
              </div>

              <a 
                href={proj.link} 
                target={proj.isExternal ? "_blank" : "_self"} 
                rel={proj.isExternal ? "noopener noreferrer" : ""} 
                class="proj-link"
              >
                <span>Acceder</span>
                <span class="link-icon">{proj.isExternal ? '↗' : '→'}</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Katarina Showcase Section -->
    <section id="katarina" class="section katarina-section">
      <div class="section-header">
        <div class="header-badge">WAIFU CORNER</div>
        <h2 class="section-title">Katarina Du Couteau <span class="highlight-red">🗡️</span></h2>
        <p class="section-sub">Mi waifu favorita de League of Legends y la inspiración principal de mi identidad gráfica.</p>
      </div>

      <div class="gallery-wrapper">
        <div class="gallery-preview-grid">
          {katarinaGallery.map((kat, index) => (
            <button 
              class={`gallery-card ${index === 0 ? 'active' : ''}`}
              data-src={kat.src}
              data-title={kat.title}
              data-subtitle={kat.subtitle}
              data-quote={kat.quote}
              data-tag={kat.tag}
            >
              <div class="gal-img-frame">
                <img src={kat.src} alt={kat.title} />
              </div>
              <div class="gal-info">
                <h4>{kat.title}</h4>
                <p>{kat.subtitle}</p>
              </div>
            </button>
          ))}
        </div>

        <div class="katarina-focus-panel">
          <div class="focus-frame">
            <img id="katarina-active-img" src="/katarina1.jpg" alt="Katarina Display" />
            <div class="focus-overlay">
              <span id="katarina-active-tag" class="focus-tag">Agility & Lethality</span>
              <h3 id="katarina-active-title">Red Daggers</h3>
              <p id="katarina-active-quote" class="focus-quote">"Never question my loyalty. You will never see what I do for Noxus."</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Me & Skills Section -->
    <section id="sobre-mi" class="section about-section">
      <div class="about-grid">
        <div class="about-card main-bio">
          <div class="header-badge">SOBRE MÍ</div>
          <h2>Desarrollo con enfoque directo</h2>
          <p>
            Me apasiona crear proyectos que combinan un excelente diseño oscuro con funcionalidad real. Desde herramientas web hasta extensiones y módulos personalizados, busco constantemente expandir mis habilidades.
          </p>
          
          <div class="bio-stats">
            <div class="stat-item">
              <span class="stat-number">PaJau</span>
              <span class="stat-label">Alias & Firma</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">GitHub</span>
              <span class="stat-label">@PaJauKat</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">Katarina</span>
              <span class="stat-label">Waifu #1</span>
            </div>
          </div>
        </div>

        <div class="about-card skills-panel">
          <div class="header-badge">STACK & HABILIDADES</div>
          <h3>Tecnologías clave</h3>
          <div class="skills-grid">
            {skills.map((s) => (
              <div class="skill-item">
                <span class="skill-icon">{s.icon}</span>
                <div class="skill-details">
                  <span class="skill-name">{s.name}</span>
                  <span class="skill-level">{s.level}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Discord Community Banner -->
      <div class="discord-banner">
        <div class="banner-content">
          <h3>¿Quieres estar al tanto de las novedades o charlar?</h3>
          <p>Súmate al servidor de Discord de la comunidad para compartir ideas, probar herramientas y más.</p>
        </div>
        <a href="/rch" target="_blank" rel="noopener noreferrer" class="btn btn-discord btn-lg">
          <span>Unirse al Discord (/rch)</span>
          <span>↗</span>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src="/logo.png" alt="Pajau Logo" class="footer-logo" />
          <span class="footer-title">PAJAU</span>
        </div>

        <p class="footer-quote">
          "Prepare for trouble... and make it Katarina." 🗡️
        </p>

        <div class="footer-links">
          <a href="https://github.com/PaJauKat" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="/rch" target="_blank" rel="noopener noreferrer">Discord</a>
          <a href="/ca-tier-calculator">Calculadora CA</a>
          <a href="/plugins">Plugins</a>
        </div>

        <div class="footer-copy">
          © {new Date().getFullYear()} Pajau. Todos los derechos reservados.
        </div>
      </div>
    </footer>

  </div>
</Layout>

<script>
  // Interactive Gallery script
  document.addEventListener('DOMContentLoaded', () => {
    const galleryCards = document.querySelectorAll('.gallery-card');
    const activeImg = document.getElementById('katarina-active-img') as HTMLImageElement;
    const activeTitle = document.getElementById('katarina-active-title');
    const activeQuote = document.getElementById('katarina-active-quote');
    const activeTag = document.getElementById('katarina-active-tag');

    galleryCards.forEach(card => {
      card.addEventListener('click', () => {
        galleryCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');

        const src = card.getAttribute('data-src');
        const title = card.getAttribute('data-title');
        const quote = card.getAttribute('data-quote');
        const tag = card.getAttribute('data-tag');

        if (activeImg && src) activeImg.src = src;
        if (activeTitle && title) activeTitle.textContent = title;
        if (activeQuote && quote) activeQuote.textContent = quote;
        if (activeTag && tag) activeTag.textContent = tag;
      });
    });
  });
</script>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 24px 60px;
    position: relative;
    z-index: 1;
  }

  /* Navbar */
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: rgba(12, 16, 24, 0.7);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    margin-bottom: 40px;
    position: sticky;
    top: 20px;
    z-index: 100;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-img {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .brand-name .dot {
    color: var(--crimson);
  }

  .brand-sub {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--crimson);
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 28px;
  }

  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--crimson-hover);
  }

  .nav-actions {
    display: flex;
    gap: 10px;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--crimson) 0%, var(--crimson-dark) 100%);
    color: #fff;
    box-shadow: 0 4px 20px var(--crimson-glow);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(255, 42, 85, 0.6);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--border-subtle);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border);
    transform: translateY(-2px);
  }

  .btn-github {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .btn-github:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .btn-discord {
    background: rgba(88, 101, 242, 0.15);
    color: #7289da;
    border-color: rgba(88, 101, 242, 0.3);
  }

  .btn-discord:hover {
    background: rgba(88, 101, 242, 0.25);
    color: #fff;
    border-color: rgba(88, 101, 242, 0.5);
    transform: translateY(-2px);
  }

  .btn-lg {
    padding: 14px 24px;
    font-size: 1rem;
  }

  /* Hero Section */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    padding: 40px 0 80px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(255, 42, 85, 0.08);
    border: 1px solid var(--border);
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--crimson);
    margin-bottom: 20px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: var(--crimson);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--crimson);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
    100% { transform: scale(0.95); opacity: 1; }
  }

  .hero-title {
    font-family: var(--font-title);
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .highlight {
    background: linear-gradient(135deg, #ff2a55 0%, #ff8099 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 28px;
    max-width: 580px;
  }

  .text-white {
    color: var(--text-primary);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }

  .tag-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Hero Visual Card */
  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .katarina-card-featured {
    position: relative;
    width: 100%;
    max-width: 420px;
    border-radius: 24px;
    padding: 2px;
    background: linear-gradient(135deg, rgba(255, 42, 85, 0.4) 0%, rgba(255, 255, 255, 0.05) 100%);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .card-glow {
    position: absolute;
    inset: -10px;
    background: radial-gradient(circle, rgba(255, 42, 85, 0.3) 0%, transparent 70%);
    filter: blur(20px);
    z-index: -1;
  }

  .card-inner {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    background: #0d111a;
    height: 500px;
  }

