---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Calculadora CA - Pajau | Combat Achievements" description="Calculadora de Combat Achievements para Old School RuneScape desarrollada por Pajau.">
  <div class="subpage-container">
    <header class="subpage-header">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver al Inicio</span>
      </a>
      <div class="header-badge">GAMING TOOLS & METRICS</div>
      <h1>Calculadora de Combat Achievements</h1>
      <p>Calcula los puntos necesarios, costo estimado y consulta las tareas pendientes para tu cuenta de Old School RuneScape.</p>
    </header>

    <!-- Form Container -->
    <div class="calculator-card">
      <div class="card-icon-header">
        <span class="card-icon">⚔️</span>
      </div>
      <h2>Consultar Nombre de Usuario</h2>
      <p>Ingresa tu RSN (RuneScape Name) para obtener la lista de Combat Achievements faltantes.</p>

      <form id="calc-form" class="search-form" onsubmit="return false;">
        <div class="input-wrapper">
          <svg class="input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="username" placeholder="Ej: Zezima" autocomplete="off" spellcheck="false" />
        </div>
        <button type="submit" id="calculate-btn" class="btn-primary">
          <span class="btn-text">Calcular Tareas</span>
          <span class="spinner hidden" id="btn-spinner"></span>
        </button>
      </form>

      <div id="error-card" class="error-card hidden">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span id="error-message">Error al calcular los puntos. Por favor, inténtalo de nuevo.</span>
      </div>
    </div>

    <!-- Summary KPI Bar -->
    <div id="results-summary" class="summary-container hidden">
      <div class="kpi-card">
        <div class="kpi-icon">🎯</div>
        <div class="kpi-content">
          <span class="kpi-label">Puntos Faltantes</span>
          <span class="kpi-value" id="kpi-pts">0</span>
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-icon">💰</div>
        <div class="kpi-content">
          <span class="kpi-label">Costo Estimado</span>
          <span class="kpi-value" id="kpi-price">$0.00</span>
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-icon">📋</div>
        <div class="kpi-content">
          <span class="kpi-label">Tareas Pendientes</span>
          <span class="kpi-value" id="kpi-tasks">0</span>
        </div>
      </div>
    </div>

    <!-- Main Results Section -->
    <div id="tasks-section" class="tasks-section hidden">
      <!-- Controls / Filters -->
      <div class="table-controls">
        <div class="table-search-wrapper">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="table-filter-input" placeholder="Filtrar por monstruo, tipo o descripción..." />
        </div>

        <div class="tier-filters" id="tier-filters">
          <button class="tier-filter-btn active" data-tier="all">Todos</button>
          <button class="tier-filter-btn easy" data-tier="easy">Easy</button>
          <button class="tier-filter-btn medium" data-tier="medium">Medium</button>
          <button class="tier-filter-btn hard" data-tier="hard">Hard</button>
          <button class="tier-filter-btn elite" data-tier="elite">Elite</button>
          <button class="tier-filter-btn master" data-tier="master">Master</button>
          <button class="tier-filter-btn gm" data-tier="grandmaster">Grandmaster</button>
        </div>
      </div>

      <div class="results-count-bar">
        <span>Mostrando <strong id="count-visible">0</strong> de <strong id="count-total">0</strong> tareas</span>
      </div>

      <!-- Table Wrapper -->
      <div class="table-card">
        <div class="table-responsive">
          <table class="ca-table">
            <thead>
              <tr>
                <th class="col-tier">TIER</th>
                <th class="col-pts">PTS</th>
                <th class="col-monster">MONSTRUO / TAREA</th>
                <th class="col-type">TIPO</th>
                <th class="col-desc">DESCRIPCIÓN</th>
                <th class="col-price">PRECIO</th>
              </tr>
            </thead>
            <tbody id="tasks-table-body">
              <!-- Dynamic Rows -->
            </tbody>
          </table>
        </div>

        <div id="table-empty-state" class="table-empty hidden">
          <span class="empty-icon">🔍</span>
          <p>No se encontraron tareas que coincidan con la búsqueda o filtro seleccionado.</p>
        </div>
      </div>
    </div>

    <!-- Initial Placeholder -->
    <div id="initial-placeholder" class="placeholder-box">
      <div class="placeholder-icon">🛡️</div>
      <h3>Ingresa un nombre de usuario</h3>
      <p>Completa el campo superior para obtener el desglose detallado de las tareas pendientes.</p>
    </div>

  </div>
</Layout>

<script>
  interface CAResponse {
    remaining_pts_needed: number;
    total_price: number;
    tasks_to_do: CATask[];
  }

  interface CATask {
    name?: string;
    tier: string;
    pts: number;
    monster: string;
    type: string;
    description: string;
    price: number;
  }

  let tasksData: CATask[] = [];
  let currentTierFilter = 'all';
  let currentSearchQuery = '';

  const calcForm = document.getElementById('calc-form') as HTMLFormElement;
  const usernameInput = document.getElementById('username') as HTMLInputElement;
  const calculateBtn = document.getElementById('calculate-btn') as HTMLButtonElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLSpanElement;
  const errorCard = document.getElementById('error-card') as HTMLDivElement;
  const errorMessage = document.getElementById('error-message') as HTMLSpanElement;

  const resultsSummary = document.getElementById('results-summary') as HTMLDivElement;
  const kpiPts = document.getElementById('kpi-pts') as HTMLSpanElement;
  const kpiPrice = document.getElementById('kpi-price') as HTMLSpanElement;
  const kpiTasks = document.getElementById('kpi-tasks') as HTMLSpanElement;

  const tasksSection = document.getElementById('tasks-section') as HTMLDivElement;
  const tasksTableBody = document.getElementById('tasks-table-body') as HTMLTableSectionElement;
  const initialPlaceholder = document.getElementById('initial-placeholder') as HTMLDivElement;
  const tableFilterInput = document.getElementById('table-filter-input') as HTMLInputElement;
  const tierFilters = document.getElementById('tier-filters') as HTMLDivElement;
  const countVisible = document.getElementById('count-visible') as HTMLSpanElement;
  const countTotal = document.getElementById('count-total') as HTMLSpanElement;
  const tableEmptyState = document.getElementById('table-empty-state') as HTMLDivElement;

  calcForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    handleCalculate();
  });

  tableFilterInput?.addEventListener('input', (e) => {
    currentSearchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    renderFilteredTasks();
  });

  tierFilters?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.tier-filter-btn') as HTMLButtonElement;
    if (!btn) return;

    tierFilters.querySelectorAll('.tier-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    currentTierFilter = btn.dataset.tier || 'all';
    renderFilteredTasks();
  });

  async function handleCalculate() {
    const username = usernameInput.value.trim();
    if (!username) return;

    setLoadingState(true);
    hideError();

    try {
      const response = await fetch(`https://x4wmc46v-42069.brs.devtunnels.ms/api/calc/${encodeURIComponent(username)}`, {
        headers: {
          'X-Tunnel-Skip-Anti-Phishing-Page': 'true',
        },
      });

      if (!response.ok) {
        throw new Error(`Error HTTP: ${response.status}`);
      }

      const data = (await response.json()) as CAResponse;
      tasksData = data.tasks_to_do || [];

      if (kpiPts) kpiPts.textContent = (data.remaining_pts_needed ?? 0).toLocaleString();
      if (kpiPrice) kpiPrice.textContent = formatCurrency(data.total_price ?? 0);
      if (kpiTasks) kpiTasks.textContent = tasksData.length.toLocaleString();

      initialPlaceholder?.classList.add('hidden');
      resultsSummary?.classList.remove('hidden');
      tasksSection?.classList.remove('hidden');

      currentSearchQuery = '';
      if (tableFilterInput) tableFilterInput.value = '';
      renderFilteredTasks();

    } catch (error) {
      console.error('Error al calcular CA:', error);
      showError('No se pudo obtener los datos del usuario. Por favor verifica el nombre o intenta nuevamente.');
    } finally {
      setLoadingState(false);
    }
  }

  function renderFilteredTasks() {
    if (!tasksTableBody) return;

    const filtered = tasksData.filter(task => {
      if (currentTierFilter !== 'all') {
        const normalizedTaskTier = normalizeTier(task.tier);
        if (normalizedTaskTier !== currentTierFilter) return false;
      }

      if (currentSearchQuery) {
        const q = currentSearchQuery;
        const matchName = task.name?.toLowerCase().includes(q);
        const matchMonster = task.monster?.toLowerCase().includes(q);
        const matchType = task.type?.toLowerCase().includes(q);
        const matchDesc = task.description?.toLowerCase().includes(q);
        const matchTier = task.tier?.toLowerCase().includes(q);
        if (!matchName && !matchMonster && !matchType && !matchDesc && !matchTier) {
          return false;
        }
      }

      return true;
    });

    if (countVisible) countVisible.textContent = filtered.length.toLocaleString();
    if (countTotal) countTotal.textContent = tasksData.length.toLocaleString();

    tasksTableBody.innerHTML = '';

    if (filtered.length === 0) {
      tableEmptyState?.classList.remove('hidden');
    } else {
      tableEmptyState?.classList.add('hidden');

      filtered.forEach(task => {
        const tr = document.createElement('tr');
        const tierNorm = normalizeTier(task.tier);

        tr.innerHTML = `
          <td class="col-tier"><span class="tier-pill ${tierNorm}">${escapeHtml(task.tier)}</span></td>
          <td class="col-pts"><span class="pts-pill">+${task.pts}</span></td>
          <td class="col-monster">
            <div class="monster-cell">
              <span class="monster-name">${escapeHtml(task.monster || '-')}</span>
              ${task.name ? `<span class="task-subname">${escapeHtml(task.name)}</span>` : ''}
            </div>
          </td>
          <td class="col-type"><span class="type-badge">${escapeHtml(task.type || '-')}</span></td>
          <td class="col-desc">${escapeHtml(task.description || '-')}</td>
          <td class="col-price"><span class="price-value ${task.price > 0 ? 'has-price' : ''}">${formatCurrency(task.price)}</span></td>
        `;

        tasksTableBody.appendChild(tr);
      });
    }
  }

  function normalizeTier(tier: string): string {
    if (!tier) return 'easy';
    const t = tier.toLowerCase().trim();
    if (t === 'gm' || t === 'grandmaster' || t === 'grand master') return 'grandmaster';
    if (t === 'master') return 'master';
    if (t === 'elite') return 'elite';
    if (t === 'hard') return 'hard';
    if (t === 'medium' || t === 'med') return 'medium';
    return 'easy';
  }

  function formatCurrency(price: number): string {
    if (!price || isNaN(price) || price === 0) return '$0.00';
    return `$${price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  function escapeHtml(str: string): string {
    return str.replace(/[&<>"']/g, (m) => {
      switch (m) {
        case '&': return '&amp;';
        case '<': return '&lt;';
        case '>': return '&gt;';
        case '"': return '&quot;';
        case "'": return '&#039;';
        default: return m;
      }
    });
  }

  function setLoadingState(loading: boolean) {
    if (calculateBtn) {
      calculateBtn.disabled = loading;
      const btnText = calculateBtn.querySelector('.btn-text');
      if (btnText) btnText.textContent = loading ? 'Calculando...' : 'Calcular Tareas';
    }
    if (btnSpinner) {
      if (loading) btnSpinner.classList.remove('hidden');
      else btnSpinner.classList.add('hidden');
    }
  }

  function showError(msg: string) {
    if (errorMessage) errorMessage.textContent = msg;
    if (errorCard) errorCard.classList.remove('hidden');
  }

  function hideError() {
    if (errorCard) errorCard.classList.add('hidden');
  }
</script>

<style>
  .subpage-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    position: relative;
    z-index: 1;
  }

  .subpage-header {
    margin-bottom: 32px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 24px;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .back-link:hover {
    color: var(--crimson);
    transform: translateX(-3px);
  }

  .header-badge {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--crimson);
    margin-bottom: 8px;
  }

  h1 {
    font-family: var(--font-title);
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* Card Form */
  .calculator-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px 28px;
    backdrop-filter: blur(12px);
    margin-bottom: 32px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .card-icon-header {
    font-size: 2.2rem;
    margin-bottom: 12px;
  }

  .calculator-card h2 {
    font-family: var(--font-title);
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .calculator-card p {
    font-size: 0.95rem;
    margin-bottom: 24px;
  }

  .search-form {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .input-wrapper {
    position: relative;
    flex: 1;
    min-width: 260px;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .input-wrapper input {
    width: 100%;
    padding: 12px 16px 12px 44px;
    background: rgba(10, 14, 23, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: all 0.2s ease;
  }

  .input-wrapper input:focus {
    border-color: var(--crimson);
    box-shadow: 0 0 0 3px rgba(255, 42, 85, 0.15);
  }

  .input-wrapper input:focus + .input-icon,
  .input-wrapper:focus-within .input-icon {
    color: var(--crimson);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 24px;
    background: linear-gradient(135deg, var(--crimson) 0%, #d91b43 100%);
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 15px rgba(255, 42, 85, 0.3);
    min-width: 150px;
    height: 46px;
  }

  .btn-primary:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(255, 42, 85, 0.45);
    background: linear-gradient(135deg, #ff476e 0%, var(--crimson) 100%);
  }

  .btn-primary:active:not(:disabled) {
    transform: translateY(1px);
  }

  .btn-primary:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    box-shadow: none;
  }

  .spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .error-card {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding: 12px 16px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 10px;
    color: #f87171;
    font-size: 0.9rem;
  }

  /* Summary KPI Bar */
  .summary-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }

  .kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    backdrop-filter: blur(10px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .kpi-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .kpi-icon {
    font-size: 2rem;
    line-height: 1;
    padding: 12px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  .kpi-content {
    display: flex;
    flex-direction: column;
  }

  .kpi-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .kpi-value {
    font-family: var(--font-title);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  /* Section & Filter Controls */
  .tasks-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .table-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
  }

  .table-search-wrapper {
    position: relative;
    flex: 1;
    min-width: 240px;
  }

  .table-search-wrapper svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  .table-search-wrapper input {
    width: 100%;
    padding: 10px 14px 10px 38px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .table-search-wrapper input:focus {
    border-color: var(--crimson);
  }

  .tier-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tier-filter-btn {
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tier-filter-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .tier-filter-btn.active {
    background: rgba(255, 255, 255, 0.15);
    border-color: #fff;
    color: #fff;
  }

  .tier-filter-btn.easy.active { background: rgba(74, 222, 128, 0.2); border-color: #4ade80; color: #4ade80; }
  .tier-filter-btn.medium.active { background: rgba(96, 165, 250, 0.2); border-color: #60a5fa; color: #60a5fa; }
  .tier-filter-btn.hard.active { background: rgba(250, 204, 21, 0.2); border-color: #facc15; color: #facc15; }
  .tier-filter-btn.elite.active { background: rgba(192, 132, 252, 0.2); border-color: #c084fc; color: #c084fc; }
  .tier-filter-btn.master.active { background: rgba(248, 113, 113, 0.2); border-color: #f87171; color: #f87171; }
  .tier-filter-btn.gm.active { background: rgba(255, 42, 85, 0.25); border-color: #ff2a55; color: #ff2a55; }

  .results-count-bar {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .results-count-bar strong {
    color: var(--text-primary);
  }

  /* Table Design */
  .table-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .ca-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }

  .ca-table th {
    background: rgba(10, 14, 23, 0.85);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ca-table td {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    vertical-align: middle;
  }

  .ca-table tbody tr {
    transition: background-color 0.15s ease;
  }

  .ca-table tbody tr:hover {
    background-color: rgba(255, 255, 255, 0.03);
  }

  .ca-table tbody tr:last-child td {
    border-bottom: none;
  }

  /* Column Widths & Specific Styling */
  .col-tier { width: 110px; }
  .col-pts { width: 70px; text-align: center; }
  .col-monster { min-width: 160px; }
  .col-type { width: 130px; }
  .col-desc { min-width: 250px; }
  .col-price { width: 110px; text-align: right; }

  .ca-table th.col-pts,
  .ca-table td.col-pts {
