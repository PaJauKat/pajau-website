---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Calculadora CA - Pajau | Combat Achievements OSRS"
    description="Calculadora interactiva de Combat Achievements para Old School RuneScape. Analiza tu progreso, puntos faltantes, costo estimado y tareas sugeridas."
>
    <div class="page-container">
        <!-- Top Navbar matching Index -->
        <header class="navbar">
            <a href="/" class="brand">
                <img src="/logo.png" alt="Pajau Logo" class="brand-img" />
                <div class="brand-text">
                    <span class="brand-name">PAJAU<span class="dot">.</span></span>
                    <span class="brand-sub">HOBBY DEV</span>
                </div>
            </a>

            <nav class="nav-links">
                <a href="/">Inicio</a>
                <a href="/ca-tier-calculator" class="active">Calculadora CA</a>
                <a href="/plugins">Plugins</a>
                <a href="/katarina">Katarina Corner</a>
            </nav>

                <div class="nav-actions">
                <a href="https://github.com/PaJauKat" target="_blank" rel="noopener noreferrer" class="btn btn-github">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                    <span>GitHub</span>
                </a>
                <!-- Discord button removed -->
            </div>
        </header>

        <!-- Page Header Section -->
        <div class="subpage-header">
            <a href="/" class="back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Volver al Inicio</span>
            </a>
            <div class="header-badge">GAMING TOOLS & OSRS METRICS ⚔️</div>
            <h1 class="page-title">Calculadora de <span class="highlight">Combat Achievements</span></h1>
            <p class="page-desc">
                Ingresa tu nombre de usuario para obtener la lista de logros de combate completados, puntos faltantes, costo estimado en GP y las tareas sugeridas para tu tier objetivo.
            </p>
        </div>

        <!-- Calculator Form Card -->
        <div class="calc-card">
            <div class="card-glow"></div>
            <form id="calc-form" class="calc-form-grid">
                <div class="form-field">
                    <label for="rsn-input">Nombre de usuario (RSN)</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <input id="rsn-input" name="username" type="text" placeholder="Ej: Zezima..." autocomplete="off" required />
                    </div>
                </div>

                <div id="target-tier-field" class="form-field hidden">
                    <label for="target-tier-select">Tier Objetivo</label>
                    <div class="select-wrapper">
                        <select id="target-tier-select">
                            <option value="EASY">Easy (41 pts)</option>
                            <option value="MEDIUM">Medium (161 pts)</option>
                            <option value="HARD">Hard (419 pts)</option>
                            <option value="ELITE">Elite (1,075 pts)</option>
                            <option value="MASTER">Master (1,945 pts)</option>
                            <option value="GRANDMASTER">Grandmaster (2,671 pts)</option>
                        </select>
                        <svg class="select-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" id="submit-btn" class="btn btn-primary btn-calc">
                        <span id="btn-icon">⚡</span>
                        <span id="btn-text">Obtener info</span>
                        <span id="btn-spinner" class="spinner hidden"></span>
                    </button>
                </div>
            </form>
            <div class="calc-footer-note">
                <span class="note-icon">ℹ️</span>
                <span>Sincronizado automáticamente con los datos oficiales de RuneLite y RuneScape Wiki API.</span>
            </div>
        </div>

        <!-- Error Card -->
        <div id="error-card" class="error-card hidden">
            <div class="error-icon">⚠️</div>
            <div class="error-body">
                <h4 id="error-title">No se pudieron consultar los datos</h4>
                <p id="error-message">Asegúrate de que el usuario haya iniciado sesión con RuneLite y la sincronización con RuneScape Wiki esté habilitada.</p>
            </div>
        </div>

        <!-- KPI Summary Bar (Hidden until search) -->
        <div id="kpi-summary" class="kpi-grid hidden">
            <div class="kpi-card kpi-card-tier">
                <div class="kpi-header">
                    <span class="kpi-label">Current Tier</span>
                    <span class="kpi-icon">🏅</span>
                </div>
                <div class="kpi-tier-content">
                    <img id="kpi-tier-image" class="kpi-tier-image" src={new URL("../assets/ca_hilts/Ghommal_hilt_1.png", import.meta.url).href} alt="Tier actual de Combat Achievement" />
                    <div class="kpi-value-row">
                        <span class="kpi-value" id="kpi-current-tier">—</span>
                    </div>
                </div>
                <span class="kpi-footer-text">Tier actual según puntos completados</span>
            </div>

            <div class="kpi-card">
                <div class="kpi-header">
                    <span class="kpi-label">Progreso Actual</span>
                    <span class="kpi-icon">🎯</span>
                </div>
                <div class="kpi-value-row">
                    <span class="kpi-value" id="kpi-completed-pts">0</span>
                    <span class="kpi-subvalue" id="kpi-target-pts">/ 1,945 PTS</span>
                </div>
                <div class="progress-bar-bg">
                    <div id="kpi-progress-bar" class="progress-bar-fill" style="width: 0%;"></div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-header">
                    <span class="kpi-label">Puntos Faltantes</span>
                    <span class="kpi-icon">⚡</span>
                </div>
                <div class="kpi-value-row">
                    <span class="kpi-value highlight-red" id="kpi-missing-pts">0</span>
                    <span class="kpi-subvalue">PTS</span>
                </div>
                <span class="kpi-footer-text" id="kpi-missing-text">Para alcanzar el tier objetivo</span>
            </div>

            <div class="kpi-card">
                <div class="kpi-header">
                    <span class="kpi-label">Costo Estimado</span>
                    <span class="kpi-icon">💰</span>
                </div>
                <div class="kpi-value-row">
                    <span class="kpi-value" id="kpi-total-price">0 GP</span>
                </div>
                <span class="kpi-footer-text">En suministros / servicios recomendados</span>
            </div>

            <!-- removed 'Tareas Recomendadas' card (replaced by Current Tier above) -->
        </div>

        <!-- Main Results Section (Hidden until search) -->
        <section id="results-section" class="results-section hidden">
            <div class="toolbar-card">
                <!-- Search & Filters -->
                <div class="toolbar-top">
                    <div class="table-search-input">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input id="search-filter" type="text" placeholder="Buscar por tarea, boss o descripción..." />
                    </div>

                    <!-- Mode tabs removed: only suggested tasks are available -->
                </div>

                <!-- Tier Filter Pills -->
                <div class="tier-filters" id="tier-filters">
                    <button class="tier-pill-btn active" data-tier="ALL">Todos los Tiers</button>
                    <button class="tier-pill-btn easy" data-tier="EASY"><span class="dot"></span>Easy</button>
                    <button class="tier-pill-btn medium" data-tier="MEDIUM"><span class="dot"></span>Medium</button>
                    <button class="tier-pill-btn hard" data-tier="HARD"><span class="dot"></span>Hard</button>
                    <button class="tier-pill-btn elite" data-tier="ELITE"><span class="dot"></span>Elite</button>
                    <button class="tier-pill-btn master" data-tier="MASTER"><span class="dot"></span>Master</button>
                    <button class="tier-pill-btn grandmaster" data-tier="GRANDMASTER"><span class="dot"></span>Grandmaster</button>
                </div>

                <div class="counter-bar">
                    <span class="counter-text">Mostrando <strong id="visible-count">0</strong> de <strong id="total-count">0</strong> tareas</span>
                </div>
            </div>

            <!-- Table Container -->
            <div class="table-card">
                <div class="table-wrapper">
                    <table class="ca-table">
                        <thead>
                            <tr>
                                <th class="col-task sortable" data-key="name">
                                    <span>TAREA</span>
                                    <span class="sort-icon"></span>
                                </th>
                                <th class="col-boss sortable" data-key="monster">
                                    <span>BOSS</span>
                                    <span class="sort-icon"></span>
                                </th>
                                <th class="col-pts sortable" data-key="pts">
                                    <span>PTS</span>
                                    <span class="sort-icon"></span>
                                </th>
                                <th class="col-tier sortable" data-key="tier">
                                    <span>TIER</span>
                                    <span class="sort-icon"></span>
                                </th>
                                <th class="col-desc">DESCRIPCIÓN</th>
                                <th class="col-price sortable" data-key="price">
                                    <span>PRECIO</span>
                                    <span class="sort-icon"></span>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="table-body">
                            <!-- Rows injected via JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Empty state inside table -->
                <div id="table-empty" class="empty-state hidden">
                    <div class="empty-icon">🔍</div>
                    <h3>No se encontraron tareas</h3>
                    <p>No hay logros que coincidan con la búsqueda o filtro seleccionado.</p>
                </div>
            </div>
        </section>

        <!-- Initial Placeholder State -->
        <div id="initial-placeholder" class="placeholder-card">
            <div class="placeholder-icon">🛡️</div>
            <h3>Consulta tu progreso de Combat Achievements</h3>
            <p>Escribe tu usuario arriba y haz clic en <strong>Calcular Tareas</strong> para ver tu informe detallado de progreso, faltantes y costo estimado.</p>
        </div>

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-inner">
                <div class="footer-brand">
                    <img src="/logo.png" alt="Pajau Logo" class="footer-logo" />
                    <span class="footer-title">PAJAU</span>
                </div>

                <p class="footer-quote">
                    "Violence solves everything... o al menos eso dice Katarina." 🗡️
                </p>

                <div class="footer-links">
                    <a href="https://github.com/PaJauKat" target="_blank" rel="noopener noreferrer">GitHub</a>
                    <a href="/ca-tier-calculator">Calculadora CA</a>
                    <a href="/plugins">Plugins</a>
                    <a href="/katarina">Katarina Corner</a>
                </div>

                <div class="footer-copy">
                    © {new Date().getFullYear()} Pajau.
                </div>
            </div>
        </footer>
    </div>
</Layout>

<script>
    import caDataRaw from "../data/final_data.json";

    interface CAData {
        wiki_ca_id: number;
        name: string;
        tier: string;
        pts: number;
        monster: string;
        type: string;
        description: string;
        comp: number;
        custom_score: number;
        price: number;
    }

    interface WikiData {
        username?: string;
        combat_achievements?: number[];
    }

    const caData = caDataRaw as CAData[];

    const TiersCA: Record<string, number> = Object.freeze({
        EASY: 41,
        MEDIUM: 161,
        HARD: 419,
        ELITE: 1075,
        MASTER: 1945,
        GRANDMASTER: 2671,
    });

    const TierOrder: Record<string, number> = Object.freeze({
        EASY: 1,
        MEDIUM: 2,
        HARD: 3,
        ELITE: 4,
        MASTER: 5,
        GRANDMASTER: 6,
    });

    const tierKeys = ["EASY", "MEDIUM", "HARD", "ELITE", "MASTER", "GRANDMASTER"] as const;

    function getTierOrder(tierKey: string): number {
        return TierOrder[tierKey] ?? 0;
    }

    function getCurrentTierKey(completedPts: number): string {
        for (let i = tierKeys.length - 1; i >= 0; i--) {
            const tierKey = tierKeys[i];
            if (completedPts >= (TiersCA[tierKey] ?? 0)) {
                return tierKey;
            }
        }

        return "Ninguno";
    }

    function getNextTierKey(currentTierKey: string): string {
        if (currentTierKey === "Ninguno") return "EASY";

        const currentIndex = tierKeys.indexOf(currentTierKey as typeof tierKeys[number]);
        if (currentIndex === -1 || currentIndex === tierKeys.length - 1) {
            return currentTierKey;
        }

        return tierKeys[currentIndex + 1];
    }

    function normalizeTargetTier(selectedTierKey: string, currentTierKey: string): string {
        if (currentTierKey === "Ninguno") return selectedTierKey;

        const selectedTierOrder = getTierOrder(selectedTierKey);
        const currentTierOrder = getTierOrder(currentTierKey);

        if (selectedTierOrder < currentTierOrder) {
            return getNextTierKey(currentTierKey);
        }

        return selectedTierKey;
    }

    function refreshTargetSelectState(currentTierKey: string, selectedTierKey: string): string {
        const normalizedTier = normalizeTargetTier(selectedTierKey, currentTierKey);

        if (targetSelect) {
            targetSelect.value = normalizedTier;
            Array.from(targetSelect.options).forEach((opt) => {
                const order = getTierOrder(opt.value);
                opt.disabled = order < getTierOrder(currentTierKey === "Ninguno" ? "EASY" : currentTierKey);
            });
        }

        return normalizedTier;
    }

    // DOM Elements
    const form = document.getElementById("calc-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    const btnText = document.getElementById("btn-text") as HTMLSpanElement | null;
    const btnSpinner = document.getElementById("btn-spinner") as HTMLSpanElement | null;
    const btnIcon = document.getElementById("btn-icon") as HTMLSpanElement | null;
    const rsnInput = document.getElementById("rsn-input") as HTMLInputElement | null;
    const targetTierField = document.getElementById("target-tier-field") as HTMLDivElement | null;
    const targetSelect = document.getElementById("target-tier-select") as HTMLSelectElement | null;

    const errorCard = document.getElementById("error-card") as HTMLDivElement | null;
    const errorMessage = document.getElementById("error-message") as HTMLParagraphElement | null;

    const kpiSummary = document.getElementById("kpi-summary") as HTMLDivElement | null;
    const kpiCompletedPts = document.getElementById("kpi-completed-pts") as HTMLSpanElement | null;
    const kpiTargetPts = document.getElementById("kpi-target-pts") as HTMLSpanElement | null;
    const kpiProgressBar = document.getElementById("kpi-progress-bar") as HTMLDivElement | null;
    const kpiMissingPts = document.getElementById("kpi-missing-pts") as HTMLSpanElement | null;
    const kpiTotalPrice = document.getElementById("kpi-total-price") as HTMLSpanElement | null;
    const kpiTasksCount = document.getElementById("kpi-tasks-count") as HTMLSpanElement | null;
    const kpiCurrentTier = document.getElementById("kpi-current-tier") as HTMLSpanElement | null;
    const kpiTierImage = document.getElementById("kpi-tier-image") as HTMLImageElement | null;

    const tierImageMap: Record<string, string> = Object.freeze({
        EASY: new URL("../assets/ca_hilts/Ghommal_hilt_1.png", import.meta.url).href,
        MEDIUM: new URL("../assets/ca_hilts/Ghommal_hilt_2.png", import.meta.url).href,
        HARD: new URL("../assets/ca_hilts/Ghommal_hilt_3.png", import.meta.url).href,
        ELITE: new URL("../assets/ca_hilts/Ghommal_hilt_4.png", import.meta.url).href,
        MASTER: new URL("../assets/ca_hilts/Ghommal_hilt_5.png", import.meta.url).href,
        GRANDMASTER: new URL("../assets/ca_hilts/Ghommal_hilt_6.png", import.meta.url).href,
    });

    const resultsSection = document.getElementById("results-section") as HTMLElement | null;
    const initialPlaceholder = document.getElementById("initial-placeholder") as HTMLDivElement | null;

    const searchFilter = document.getElementById("search-filter") as HTMLInputElement | null;
    const tierFiltersContainer = document.getElementById("tier-filters") as HTMLDivElement | null;
    const tbody = document.getElementById("table-body") as HTMLTableSectionElement | null;
    const tableEmpty = document.getElementById("table-empty") as HTMLDivElement | null;
    const visibleCount = document.getElementById("visible-count") as HTMLSpanElement | null;
    const totalCount = document.getElementById("total-count") as HTMLSpanElement | null;

    // State Variables
    let allCompletedTasks: CAData[] = [];
    let allIncompleteTasks: CAData[] = [];
    let suggestedTasks: CAData[] = [];

    let currentViewMode: "suggested" | "all-incomplete" | "completed" = "suggested";
    let activeTierFilter = "ALL";
    let activeSearchQuery = "";
    let currentSort = { key: "custom_score", dir: "desc" as "asc" | "desc" };

    function formatPrice(val: number): string {
        if (!val || val <= 0) return "0 GP";
        if (val >= 1000) return `${(val / 1000).toFixed(1)}B GP`;
        if (val >= 1) return `${val % 1 === 0 ? val : val.toFixed(1)}M GP`;
        return `${Math.round(val * 1000)}k GP`;
    }

    function escapeHtml(str: string): string {
        return str
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function renderTable() {
        if (!tbody) return;

        let sourceList: CAData[] = [];
        if (currentViewMode === "suggested") sourceList = suggestedTasks;
        else if (currentViewMode === "all-incomplete") sourceList = allIncompleteTasks;
        else sourceList = allCompletedTasks;

        // Apply Tier and Search filters
        let filtered = sourceList.filter((task) => {
            if (activeTierFilter !== "ALL" && task.tier.toUpperCase() !== activeTierFilter) {
                return false;
            }

            if (activeSearchQuery) {
                const q = activeSearchQuery.toLowerCase();
                const matchName = task.name.toLowerCase().includes(q);
                const matchMonster = task.monster.toLowerCase().includes(q);
                const matchType = task.type.toLowerCase().includes(q);
                const matchDesc = task.description.toLowerCase().includes(q);
                const matchTier = task.tier.toLowerCase().includes(q);
                if (!matchName && !matchMonster && !matchType && !matchDesc && !matchTier) {
                    return false;
                }
            }

            return true;
        });

        // Apply Sorting
        if (currentSort.key) {
            const dir = currentSort.dir === "asc" ? 1 : -1;
            const key = currentSort.key;

            filtered.sort((a: any, b: any) => {
                if (key === "tier") {
                    const tA = TierOrder[a.tier.toUpperCase()] || 0;
                    const tB = TierOrder[b.tier.toUpperCase()] || 0;
                    return (tA - tB) * dir;
                }
                const va = a[key];
                const vb = b[key];
                if (typeof va === "number" && typeof vb === "number") {
                    return (va - vb) * dir;
                }
                return String(va ?? "").localeCompare(String(vb ?? "")) * dir;
            });
        }

        if (visibleCount) visibleCount.textContent = filtered.length.toLocaleString();
        if (totalCount) totalCount.textContent = sourceList.length.toLocaleString();

        tbody.innerHTML = "";

        if (filtered.length === 0) {
            tableEmpty?.classList.remove("hidden");
        } else {
            tableEmpty?.classList.add("hidden");

            for (const ca of filtered) {
                const tr = document.createElement("tr");
                const tierClass = ca.tier.toLowerCase();

                tr.innerHTML = `
                    <td class="col-task">
                        <div class="task-cell">
                            <span class="task-name">${escapeHtml(ca.name)}</span>
                        </div>
                    </td>
                    <td class="col-boss">
                        <span class="boss-pill">${escapeHtml(ca.monster || "General")}</span>
                    </td>
                    <td class="col-pts">
                        <span class="pts-badge">+${ca.pts}</span>
                    </td>
                    <td class="col-tier">
                        <span class="tier-pill ${tierClass}">
                            <span class="dot"></span>
                            ${escapeHtml(ca.tier)}
                        </span>
                    </td>
                    <td class="col-desc">
                        <p class="desc-text">${escapeHtml(ca.description)}</p>
                    </td>
                    <td class="col-price">
                        <span class="price-pill ${ca.price > 0 ? "has-price" : "free"}">
                            ${formatPrice(ca.price)}
                        </span>
                    </td>
                `;

                tbody.appendChild(tr);
            }
        }

        // Update sorting header indicators
        document.querySelectorAll("th.sortable").forEach((th) => {
            th.classList.remove("asc", "desc");
            const key = th.getAttribute("data-key");
            if (key === currentSort.key) {
                th.classList.add(currentSort.dir);
            }
        });
    }

    // Attach Table Header Sort Handlers
    document.querySelectorAll("th.sortable").forEach((th) => {
        th.addEventListener("click", () => {
            const key = th.getAttribute("data-key");
            if (!key) return;

            if (currentSort.key === key) {
                currentSort.dir = currentSort.dir === "asc" ? "desc" : "asc";
            } else {
                currentSort.key = key;
                currentSort.dir = key === "price" || key === "pts" ? "desc" : "asc";
            }

            renderTable();
        });
    });

    // Attach Search Filter
    searchFilter?.addEventListener("input", (e) => {
        activeSearchQuery = (e.target as HTMLInputElement).value.trim();
        renderTable();
    });

    // Attach Tier Filter Pills
    tierFiltersContainer?.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest(".tier-pill-btn") as HTMLButtonElement | null;
        if (!btn) return;

        tierFiltersContainer.querySelectorAll(".tier-pill-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        activeTierFilter = btn.getAttribute("data-tier") || "ALL";
        renderTable();
    });

    targetSelect?.addEventListener("change", () => {
        if (!allCompletedTasks.length && !allIncompleteTasks.length) return;

        const completedPts = allCompletedTasks.reduce((sum, task) => sum + task.pts, 0);
        const currentTierKey = getCurrentTierKey(completedPts);
        const selectedTierKey = refreshTargetSelectState(currentTierKey, targetSelect.value);

        const targetTierPts = TiersCA[selectedTierKey] ?? TiersCA.MASTER;
        const missingPts = Math.max(0, targetTierPts - completedPts);

        if (kpiTargetPts) kpiTargetPts.textContent = `/ ${targetTierPts.toLocaleString()} PTS (${selectedTierKey})`;
        if (kpiMissingPts) kpiMissingPts.textContent = missingPts.toLocaleString();
        if (kpiCurrentTier) kpiCurrentTier.textContent = currentTierKey;

        const sortedIncomplete = [...allIncompleteTasks].sort((a, b) => b.custom_score - a.custom_score);
        let ptsAcc = 0;
        let totalPrice = 0;
        const nextSuggestedTasks: CAData[] = [];

        for (const ca of sortedIncomplete) {
            if (ptsAcc >= missingPts && missingPts > 0) break;
            ptsAcc += ca.pts;
            totalPrice += ca.price;
            nextSuggestedTasks.push(ca);
        }

        suggestedTasks = nextSuggestedTasks;
        if (kpiTotalPrice) kpiTotalPrice.textContent = formatPrice(totalPrice);
        if (kpiTasksCount) kpiTasksCount.textContent = nextSuggestedTasks.length.toLocaleString();

        renderTable();
    });

    // mode-tabs removed; only 'suggested' mode is supported

    // Form Submit Handler
    form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const rsn = rsnInput?.value.trim() ?? "";
        if (!rsn) return;

        // UI Loading State
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = "Buscando...";
        if (btnSpinner) btnSpinner.classList.remove("hidden");
        if (btnIcon) btnIcon.classList.add("hidden");

        errorCard?.classList.add("hidden");

        try {
            const params = new URLSearchParams({ username: rsn });
            const resp = await fetch(`/api/ca-tier?${params.toString()}`);

            if (!resp.ok) {
                const errData = await resp.json().catch(() => ({}));
                throw new Error(errData.error || `No se pudo encontrar al jugador '${rsn}'. (Status ${resp.status})`);
            }

            const data = (await resp.json()) as WikiData;
            const completedIds = new Set(data.combat_achievements ?? []);

            let completedPts = 0;
            allCompletedTasks = [];
            allIncompleteTasks = [];

            for (const ca of caData) {
                if (completedIds.has(ca.wiki_ca_id)) {
                    completedPts += ca.pts;
                    allCompletedTasks.push(ca);
                } else {
                    allIncompleteTasks.push(ca);
                }
            }

            const currentTierKey = getCurrentTierKey(completedPts);
            const currentTierOrder = getTierOrder(currentTierKey === "Ninguno" ? "EASY" : currentTierKey);

            if (targetTierField) targetTierField.classList.remove("hidden");

            const defaultTargetTier = getNextTierKey(currentTierKey);
            const selectedTierKey = refreshTargetSelectState(currentTierKey, targetSelect?.value ?? defaultTargetTier);

            const targetTierPts = TiersCA[selectedTierKey] ?? TiersCA.MASTER;
            let missingPts = Math.max(0, targetTierPts - completedPts);

            // Sort incomplete tasks by custom_score descending to pick best recommended tasks
            const sortedIncomplete = [...allIncompleteTasks].sort((a, b) => b.custom_score - a.custom_score);

            suggestedTasks = [];
            let totalPrice = 0;
            let ptsAcc = 0;

            for (const ca of sortedIncomplete) {
                if (ptsAcc >= missingPts && missingPts > 0) break;
                ptsAcc += ca.pts;
                totalPrice += ca.price;
                suggestedTasks.push(ca);
            }

            

            // Keep tier filter pills enabled (do not disable); remove any completed labels if present
            document.querySelectorAll<HTMLButtonElement>(".tier-pill-btn").forEach((b) => {
                const tier = b.getAttribute("data-tier");
                if (!tier || tier === "ALL") return;
                b.classList.remove("completed");
                b.disabled = false;
                const lab = b.querySelector(".completed-label");
                if (lab) lab.remove();
            });

            // Disable target select options for tiers lower than the current tier
            if (targetSelect) {
                Array.from(targetSelect.options).forEach((opt) => {
                    const val = opt.value;
                    const order = getTierOrder(val);
                    opt.disabled = order < currentTierOrder;
                });

                const selectedOption = Array.from(targetSelect.options).find((opt) => opt.value === selectedTierKey);
                if (!selectedOption || selectedOption.disabled) {
                    const firstAvailable = Array.from(targetSelect.options).find((opt) => !opt.disabled) as HTMLOptionElement | undefined;
                    if (firstAvailable) {
                        targetSelect.value = firstAvailable.value;
                    }
                }
            }

            // Update KPI cards
            if (kpiCompletedPts) kpiCompletedPts.textContent = completedPts.toLocaleString();
            if (kpiTargetPts) kpiTargetPts.textContent = `/ ${targetTierPts.toLocaleString()} PTS (${selectedTierKey})`;
            if (kpiMissingPts) kpiMissingPts.textContent = missingPts.toLocaleString();
            if (kpiTotalPrice) kpiTotalPrice.textContent = formatPrice(totalPrice);
            if (kpiTasksCount) kpiTasksCount.textContent = suggestedTasks.length.toLocaleString();
            if (kpiCurrentTier) kpiCurrentTier.textContent = currentTierKey;
            if (kpiTierImage) {
                const imageSrc = tierImageMap[currentTierKey] ?? tierImageMap.EASY;
                kpiTierImage.src = imageSrc;
                kpiTierImage.alt = `Ghommal hilt de tier ${currentTierKey}`;
            }

            const progressPercent = Math.min(100, Math.round((completedPts / targetTierPts) * 100));
            if (kpiProgressBar) kpiProgressBar.style.width = `${progressPercent}%`;

            // Reveal Results UI
            initialPlaceholder?.classList.add("hidden");
            kpiSummary?.classList.remove("hidden");
            resultsSection?.classList.remove("hidden");

            // Reset filters & Render (only suggested mode supported)
            currentViewMode = "suggested";

            currentSort = { key: "custom_score", dir: "desc" };
            renderTable();

            // Smooth scroll to KPI bar
            kpiSummary?.scrollIntoView({ behavior: "smooth", block: "start" });

        } catch (err: any) {
            console.error("Error fetching CA tier data:", err);
            if (errorCard) errorCard.classList.remove("hidden");
            if (errorMessage) errorMessage.textContent = err.message || "Ocurrió un error inesperado al consultar la API.";
        } finally {
            if (submitBtn) submitBtn.disabled = false;
            if (btnText) btnText.textContent = "Obtener info";
            if (btnSpinner) btnSpinner.classList.add("hidden");
            if (btnIcon) btnIcon.classList.remove("hidden");
        }
    });
</script>

