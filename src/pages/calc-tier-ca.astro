---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Calculate Tier CA"
    description="Calculate your Tier CA based on your inputs."
>
    <h1>Calculate Tier CA</h1>
    <p>Use this tool to calculate your Tier CA based on your inputs.</p>

    <form id="calc-form">
        <input id="rsn-input" name="username" type="text" placeholder="Username..." />
        <button type="submit">Calculate</button>
    </form>

    <table>
        <thead>
            <tr>
                <th>Task Name</th>
                <th>Boss</th>
                <th>Points</th>
                <th>Description</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            <!-- Add your calculation results here -->
        </tbody>
    </table>
</Layout>

<script>
    import caDataRaw from "../data/final_data.json";

    interface CAData {
        wiki_ca_id: number;
        name: string;
        tier: string;
        pts: number;
        monster: string;
        type: string;
        description: string;
        comp: number;
        custom_score: number;
        price: number;
        requirements?: { [key: string]: any };
    }

    interface WikiData {
        username?: string;
        combat_achievements?: number[];
    }

    const caData = caDataRaw as CAData[];

    const TiersCA = Object.freeze({
        EASY: 41,
        MEDIUM: 161,
        HARD: 419,
        ELITE: 1075,
        MASTER: 1945,
        GRANDMASTER: 2671,
    });

    const form = document.getElementById("calc-form") as HTMLFormElement | null;
    const btn = document.querySelector("button[type='submit']") as HTMLButtonElement | null;
    const input = document.getElementById("rsn-input") as HTMLInputElement | null;
    const tbody = document.querySelector("tbody") as HTMLTableSectionElement | null;

    form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const rsn = input?.value.trim() ?? "";

        if (!tbody) return;

        if (!rsn) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="3">Please enter a username.</td>
                </tr>
            `;
            return;
        }

        btn && (btn.disabled = true);
        btn && (btn.textContent = "Calculating...");
        tbody.innerHTML = "";

        try {
            const params = new URLSearchParams({ username: rsn });
            const resp = await fetch(`/api/ca-tier?${params.toString()}`);

            if (!resp.ok) {
                const errorData = await resp.json().catch(() => ({}));
                throw new Error(errorData.error || `Request failed with status ${resp.status}`);
            }

            const data = (await resp.json()) as WikiData;
            const completedAchievements = data.combat_achievements ?? [];

            let completed = 0;
            const incomplete: CAData[] = [];

            for (const ca of caData) {
                if (completedAchievements.includes(ca.wiki_ca_id)) {
                    completed += ca.pts;
                } else {
                    incomplete.push(ca);
                }
            }
            console.log("Completed=", completedAchievements.length)
            console.log("Incompleted=", incomplete.length)

            let targetTier = TiersCA.MASTER;
            let ptsNeeded = targetTier - completed;
            console.log("PTs needed=", ptsNeeded)
            const tasksToComplete: CAData[] = [];
            let totalPrice = 0;

            incomplete.sort((a, b) => b.custom_score - a.custom_score);

            for (const ca of incomplete) {
                if (ptsNeeded <= 0) break;
                ptsNeeded -= ca.pts;
                tasksToComplete.push(ca);
                totalPrice += ca.price;
            }

            tbody.innerHTML = "";

            if (tasksToComplete.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3">You already have enough CA points for the selected tier.</td>
                    </tr>
                `;
            } else {
                for (const ca of tasksToComplete) {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td>${ca.name}</td>
                        <td>${ca.monster}</td>
                        <td>${ca.pts}</td>
                        <td>${ca.description}</td>
                        <td>${ca.price}</td>
                    `;
                    tbody.appendChild(row);
                }
            }

            console.log(`Completed CA points: ${completed}`);
            console.log(`Missing points for Master: ${Math.max(0, ptsNeeded)}`);
            console.log(`Total price of tasks: ${totalPrice}`);
        } catch (error) {
            console.error("Error en la petición fetch:", error);
            tbody.innerHTML = `
                <tr>
                    <td colspan="3">${error instanceof Error ? error.message : "Something went wrong."}</td>
                </tr>
            `;
        } finally {
            btn && (btn.disabled = false);
            btn && (btn.textContent = "Calculate");
        }
    });
</script>
